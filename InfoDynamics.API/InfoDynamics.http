@baseUrl=https://localhost:7293

### Obtener empresa por id
GET {{baseUrl}}/api/Empresa/

# OBTENER VACACIONES
GET {{baseUrl}}/api/Vacacion
Accept: application/json

###

# CREAR SOLICITUD DE VACACION
POST {{baseUrl}}/api/Vacacion
Content-Type: application/json
Accept: application/json

### Actualizar empresa
POST {{baseUrl}}/api/Empresa/update/4
Content-Type: application/json
Accept: application/json

{
  "idEmpresa": 4,
  "nombre": "OXXO",
  "descripcion": "Siempre listos siempre hola",
  "rowVersion": "AAAAAAAARlE="
}

###

# APROBAR SOLICITUD
POST {{baseUrl}}/api/Vacacion/1/evaluar
Content-Type: application/json
Accept: application/json

{
  "vacacionId": 1,
  "aprobadorId": 2,
  "estadoDecision": "Aprobada",
  "rowVersion": "AAAAAAAAB9E="
}

###

# RECHAZAR SOLICITUD
POST {{baseUrl}}/api/Vacacion/1/evaluar
Content-Type: application/json
Accept: application/json

{
  "identificador": "holacomoestas@gmail.com",
  "contrasena": "batmaneljefe"
}


