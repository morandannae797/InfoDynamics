@baseUrl = https://localhost:7293

### Obtener empresa por id
GET {{baseUrl}}/api/Empresa
### Obtener 
GET {{baseUrl}}/api/Usuario/


Accept: application/json

### Crear Usuario admin
POST {{baseUrl}}/api/Usuario
Content-Type: application/json
Accept: application/json

{
 "noUsuario": 56,
    "nombre": "Johny",
    "apPaterno": "Guitar",
    "apMaterno": "lopez",
    "email": "johny@gmail.com",
    "rol": "Administrador",
  
    "contrasena": "batmanwashere"
}

####hola
POST {{baseUrl}}/api/Empresa/
Content-Type: application/json
Accept: application/json

{
  "idEmpresa": 4,
  "nombre": "OXXO",
  "descripcion": "Siempre listos siempre ahi.",
  "rowVersion": "AAAAAAAARlE="
}


### Login
POST {{baseUrl}}/api/LogIn/login
Content-Type: application/json
Accept: application/json

{
  "identificador":  "holacomoestas@gmail.com",
  "contrasena":  "batmaneljefe"
}
### Logout
POST {{baseUrl}}/api/LogIn/logout
Content-Type: application/json
Accept: application/json

